{
  "name": "Lumet",
  "options": {
    "bundleIdPrefix": "app.bitrig.lumet"
  },
  "targets": {
    "Lumet": {
      "type": "application",
      "platform": "macOS",
      "deploymentTarget": {
        "macOS": "14.0"
      },
      "sources": [
        { "path": "Sources" },
        { "path": "App" }
      ],
      "resources": [
        { "path": "App/Assets.xcassets" }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.lumet.96f53b75",
          "PRODUCT_NAME": "Lumet",
          "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
          "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
          "SWIFT_VERSION": "5.9",
          "MACOSX_DEPLOYMENT_TARGET": "14.0",
          "LSApplicationCategoryType": "public.app-category.entertainment",
          "ENABLE_HARDENED_RUNTIME": "YES"
        }
      },
      "entitlements": {
        "path": "App/Lumet.entitlements",
        "properties": {
          "com.apple.security.app-sandbox": true,
          "com.apple.security.network.client": true,
          "com.apple.security.files.user-selected.read-write": true,
          "com.apple.security.files.downloads.read-write": true
        }
      },
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Lumet",
          "CFBundleShortVersionString": "1.0.0",
          "CFBundleVersion": "1",
          "NSHumanReadableCopyright": "© 2024 Lumet. All rights reserved.",
          "LSMinimumSystemVersion": "14.0",
          "NSSupportsAutomaticTermination": false,
          "NSSupportsSuddenTermination": false,
          "NSAppTransportSecurity": {
            "NSAllowsArbitraryLoads": true
          }
        }
      }
    }
  }
}
